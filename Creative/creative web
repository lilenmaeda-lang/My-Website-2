<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lilen Maeda - Creative</title>

  <!-- GOOGLE FONTS -->
  <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@700&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">

  <!-- SOCIAL ICONS -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    body{
      margin:0;
      font-family:"Poppins",sans-serif;
      background:#fff;
      color:#111;
    }

    .main-nav{
      width:100%;
      padding:32px 60px 0 60px;
      box-sizing:border-box;
      background:#fff;
    }

    .nav-inner{
      display:flex;
      justify-content:space-between;
      align-items:center;
    }

    .nav-name{
      font-family:"Merriweather",serif;
      font-size:34px;
      font-weight:700;
      letter-spacing:0.03em;
      text-decoration:none;
      color:#111;
    }

    .nav-social{
      display:flex;
      align-items:center;
      gap:18px;
    }

    .nav-social a{
      font-size:18px;
      color:#111;
      transition:opacity 0.2s ease;
    }

    .nav-social a:hover{
      opacity:0.6;
    }

    .creative-page{
      padding:40px 60px 80px 60px;
      box-sizing:border-box;
    }

    .creative-intro{
      max-width:700px;
      margin-bottom:50px;
    }

    .creative-intro h1{
      margin:0 0 14px 0;
      font-family:"Merriweather",serif;
      font-size:48px;
      font-weight:700;
    }

    .creative-intro p{
      margin:0;
      font-size:16px;
      line-height:1.7;
      font-weight:300;
      max-width:560px;
    }

    .creative-gallery{
      display:grid;
      grid-template-columns:repeat(2, minmax(0, 1fr));
      gap:36px;
      align-items:start;
    }

    .art-piece{
      width:100%;
      overflow:hidden;
      position:relative;
      background:#f5f5f5;
    }

    .art-piece img{
      width:100%;
      height:100%;
      display:block;
      object-fit:cover;
    }

    .square{
      aspect-ratio:1 / 1;
    }

    .tall{
      aspect-ratio:4 / 5;
    }

    .wide{
      aspect-ratio:16 / 10;
    }

    .flower{
      border-radius:60% 40% 65% 35% / 40% 60% 35% 65%;
      box-shadow:0 10px 30px rgba(0,0,0,0.14);
    }

    .flower-two{
      border-radius:50% 50% 35% 65% / 60% 40% 60% 40%;
      box-shadow:0 10px 30px rgba(0,0,0,0.14);
    }

    .caption{
      margin-top:12px;
      font-size:12px;
      letter-spacing:0.08em;
      text-transform:uppercase;
    }

    .piece-group{
      display:flex;
      flex-direction:column;
    }

    @media (max-width: 900px){
      .main-nav{
        padding:24px 20px 0 20px;
      }

      .nav-name{
        font-size:28px;
      }

      .creative-page{
        padding:30px 20px 60px 20px;
      }

      .creative-intro h1{
        font-size:38px;
      }

      .creative-gallery{
        grid-template-columns:1fr;
        gap:28px;
      }
    }
  </style>
</head>
